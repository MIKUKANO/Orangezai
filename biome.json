{
    "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**",
            "!.github",
            "!.vscode",
            "!lib/modules"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120,
        "expand": "always"
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "complexity": {
                "useArrowFunction": "off",
                "useOptionalChain": "off"
            },
            "correctness": {
                "noConstructorReturn": "off",
                "noUnusedFunctionParameters": "off",
                "noUnusedImports": "off",
                "noUnusedVariables": "off"
            },
            "suspicious": {
                "noAssignInExpressions": "off",
                "noDoubleEquals": "off",
                "noFallthroughSwitchClause": "off"
            },
            "style": {
                "useTemplate": "off",
                "useConst": "off",
                "useNodejsImportProtocol": "off",
                "useBlockStatements": "error"
            }
        }
    },
    "javascript": {
        "globals": [
            "Bot",
            "Renderer",
            "logger",
            "plugin",
            "redis",
            "segment"
        ],
        "formatter": {
            "arrowParentheses": "asNeeded",
            "quoteStyle": "double",
            "semicolons": "asNeeded",
            "trailingCommas": "none"
        }
    },
    "assist": {
        "enabled": false
    }
}
