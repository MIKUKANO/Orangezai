{
    "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": false
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**",
            "!.github",
            "!.vscode",
            "!plugins/*",
            "plugins/adapter",
            "!data",
            "!logs",
            "!node_modules",
            "!temp",
            "!dump.rdb",
            "!.ace-tool",
            "!.trae",
            "!lib/modules"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120,
        "expand": "always"
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "complexity": {
                "useArrowFunction": "off",
                "useOptionalChain": "off"
            },
            "correctness": {
                "noConstructorReturn": "off",
                "noUnusedFunctionParameters": "off",
                "noUnusedImports": "off",
                "noUnusedVariables": "off"
            },
            "suspicious": {
                "noAssignInExpressions": "off",
                "noDoubleEquals": "off",
                "noFallthroughSwitchClause": "off"
            },
            "style": {
                "useTemplate": "off",
                "useConst": "off",
                "useNodejsImportProtocol": "off",
                "useBlockStatements": "error"
            }
        }
    },
    "javascript": {
        "globals": [
            "Bot",
            "Renderer",
            "logger",
            "plugin",
            "redis",
            "segment"
        ],
        "formatter": {
            "arrowParentheses": "asNeeded",
            "quoteStyle": "double",
            "semicolons": "asNeeded",
            "trailingCommas": "none"
        }
    },
    "overrides": [
        {
            "includes": [
                "plugins/adapter/**/*.js"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "useBlockStatements": "off"
                    }
                }
            }
        }
    ],
    "assist": {
        "enabled": false
    }
}
